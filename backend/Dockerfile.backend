FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    OLLAMA_MODELS=/root/.ollama/models

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    ca-certificates \
    libgl1 \
    libglib2.0-0 \
    zstd \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Install Ollama binary directly
RUN curl -fsSL https://ollama.com/download/ollama-linux-amd64.tar.zst | zstd -d | tar x -C /usr
WORKDIR /app/backend

# Copy and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Bake nomic-embed-text weights into container with active health check
RUN ollama serve & \
    PID=$! && \
    while ! curl -s http://localhost:11434/api/tags > /dev/null; do sleep 1; done && \
    ollama pull nomic-embed-text && \
    kill $PID

# Copy application source code
COPY . .

# Fix potential Windows CRLF line-ending issues & set permissions
RUN sed -i 's/\r$//' entrypoint.sh && chmod +x entrypoint.sh

ENTRYPOINT ["./entrypoint.sh"]
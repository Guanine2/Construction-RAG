FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Install lightweight Streamlit dependencies
RUN pip install --no-cache-dir streamlit requests pillow google-auth

# Ensure destination ends with a trailing slash
COPY app.py /app/

# Cloud Run injects $PORT dynamically at runtime (defaults to 8080)
CMD streamlit run app.py \
    --server.port=${PORT:-8080} \
    --server.address=0.0.0.0 \
    --server.enableCORS=false \
    --server.enableXsrfProtection=false